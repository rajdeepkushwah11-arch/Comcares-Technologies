{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/router.php?path=index.php"
    },
    {
      "src": "^/index\\.php$",
      "dest": "/api/router.php?path=index.php"
    },
    {
      "src": "^/about\\.php$",
      "dest": "/api/router.php?path=about.php"
    },
    {
      "src": "^/services\\.php$",
      "dest": "/api/router.php?path=services.php"
    },
    {
      "src": "^/products\\.php$",
      "dest": "/api/router.php?path=products.php"
    },
    {
      "src": "^/contact\\.php$",
      "dest": "/api/router.php?path=contact.php"
    },
    {
      "src": "^/login\\.php$",
      "dest": "/api/router.php?path=login.php"
    },
    {
      "src": "^/forgot-password\\.php$",
      "dest": "/api/router.php?path=forgot-password.php"
    },
    {
      "src": "^/reset-password\\.php$",
      "dest": "/api/router.php?path=reset-password.php"
    },
    {
      "src": "^/logout\\.php$",
      "dest": "/api/router.php?path=logout.php"
    },
    {
      "src": "^/api/chatbot\\.php$",
      "dest": "/api/router.php?path=api/chatbot.php"
    },
    {
      "handle": "filesystem"
    }
  ]
}
